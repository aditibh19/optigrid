# ── Database ──────────────────────────────────────────────────────────────
# Default: SQLite, a single local file. Works on any laptop with nothing to install.
DATABASE_URL=sqlite:///./evoptigrid.db
# PostgreSQL (recommended for a real deployment; needs a running server and an existing database):
# DATABASE_URL=postgresql+psycopg2://evoptigrid:evoptigrid@localhost:5432/evoptigrid

# ── Auth ──────────────────────────────────────────────────────────────────
# Any string works for local development. In production, use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Provider abstraction ─────────────────────────────────────────────────
# Any provider left blank/"demo" falls back to the Demo* implementation and
# the API responses are tagged source="simulated" or source="demo".

# maps/routing provider: "demo" | "mapbox" | "osrm" | "google"
ROUTING_PROVIDER=demo
ROUTING_PROVIDER_API_KEY=

# charging station discovery provider: "demo" | "openchargemap"
STATION_PROVIDER=demo
STATION_PROVIDER_API_KEY=

# weather provider (for elevation/traffic-adjacent context): "demo" | "openweather"
WEATHER_PROVIDER=demo
WEATHER_PROVIDER_API_KEY=

# LLM provider for the AI Copilot: "demo" | "anthropic"
LLM_PROVIDER=demo
LLM_PROVIDER_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

# Simulator cost guard: max (cars x repetitions x time slots) accepted by POST /api/simulation/run
# when the SDP is included. ~16 policy solves/second on a cold cache. See docs/SIMULATION.md.
SIM_MAX_WORK=1500

# Background model warm-up at startup (services/scheduler.py)
ENABLE_SCHEDULER=true
